rules_version = '2';

// Modelo de datos (ver docs/datos.md):
//   users/{uid}                          perfil público (nombre y foto)
//   config/current                       torneo de la semana (lo escribe el motor)
//   tournaments/{tid}                    torneo (motor)
//   tournaments/{tid}/players/{pid}      jugadores con precio, estado y puntos (motor)
//   picks/{tid}_{uid}                    equipo elegido; privado hasta la primera salida
//   entries/{tid}_{uid}                  equipo publicado con sus puntos (motor)
//   leagues/{lid}, leagueCodes/{code}    ligas privadas y su código de invitación
//   seasons/{year}/standings/{uid}       clasificación de la temporada (motor)
// El motor usa la cuenta de servicio de Firebase, que no pasa por estas reglas.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function isOptionalText(value, max) { return value == null || (value is string && value.size() <= max); }

    match /users/{uid} {
      // Color y nombre del club (opcionales). Los colores son los de src/lib/clubs.js
      function validClub(d) {
        return (!('color' in d) || d.color in ['pino', 'granate', 'marino', 'laguna', 'teja', 'violeta', 'azul', 'carbon'])
          && (!('clubName' in d) || isOptionalText(d.clubName, 30));
      }

      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'isAdmin', 'createdAt', 'color', 'clubName'])
        && isText(request.resource.data.displayName, 1, 60)
        && isOptionalText(request.resource.data.photoURL, 500)
        && validClub(request.resource.data)
        && request.resource.data.isAdmin == false
        && request.resource.data.createdAt == request.time;
      // isAdmin solo se cambia desde la consola de Firebase. Los perfiles de la versión antigua
      // guardaban email y uid: se permite borrarlos (nunca añadirlos)
      allow update: if isUser(uid)
        && onlyChanges(['displayName', 'photoURL', 'color', 'clubName', 'email', 'uid'])
        && !('email' in request.resource.data)
        && !('uid' in request.resource.data)
        && isText(request.resource.data.displayName, 1, 60)
        && isOptionalText(request.resource.data.photoURL, 500)
        && validClub(request.resource.data);

      // Dispositivos con avisos activados. Solo el motor los lee; cada uno gestiona los suyos
      match /tokens/{token} {
        allow create, update: if isUser(uid)
          && token.size() < 400
          && request.resource.data.keys().hasOnly(['createdAt', 'userAgent'])
          && request.resource.data.createdAt == request.time
          && isOptionalText(request.resource.data.userAgent, 200);
        allow delete: if isUser(uid);
      }
    }

    match /config/{doc} {
      allow read: if signedIn();
    }

    match /tournaments/{tid} {
      allow read: if signedIn();
      match /players/{pid} {
        allow read: if signedIn();
      }
    }

    match /entries/{id} {
      allow read: if signedIn();
    }

    match /seasons/{year}/standings/{uid} {
      allow read: if signedIn();
    }

    // Equipo: 6 jugadores distintos del torneo, un capitán entre ellos, sin pasarse de 100M
    // y solo antes de la primera salida. El coste se comprueba con los precios guardados.
    match /picks/{id} {
      function tournament() { return get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data; }
      function price(i) {
        return get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/players/$(request.resource.data.playerIds[i])).data.price;
      }
      // Comodines (uno de cada por temporada; el motor ignora el que ya se haya gastado):
      // 'triple' = capitán x3, 'seventh' = séptimo jugador
      function validPicks() {
        let d = request.resource.data;
        let chip = d.get('chip', null);
        let size = chip == 'seventh' ? 7 : 6;
        let cost6 = price(0) + price(1) + price(2) + price(3) + price(4) + price(5);
        return d.keys().hasOnly(['uid', 'tournamentId', 'playerIds', 'captainId', 'cost', 'chip', 'displayName', 'photoURL', 'updatedAt'])
          && d.uid == request.auth.uid
          && id == d.tournamentId + '_' + d.uid
          && chip in [null, 'triple', 'seventh']
          && d.playerIds is list && d.playerIds.size() == size && d.playerIds.toSet().size() == size
          && d.captainId in d.playerIds
          && isText(d.displayName, 1, 60)
          && isOptionalText(d.photoURL, 500)
          && d.updatedAt == request.time
          && request.time < tournament().firstTeeTime
          && ((size == 6 && d.cost == cost6) || (size == 7 && d.cost == cost6 + price(6)))
          && d.cost <= 100;
      }

      // Por el id y no por resource, para poder consultar el propio equipo aunque aún no exista
      allow get: if signedIn() && id.matches('.*_' + request.auth.uid);
      allow create, update: if signedIn() && validPicks();
    }

    // Modo «Sin repetir» (one and done): un golfista y un suplente por torneo, distintos y del torneo,
    // privado hasta la primera salida. Que no se repita en la temporada lo controla el motor.
    match /oadPicks/{id} {
      function oadTournament() { return get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data; }
      function inField(pid) { return exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)/players/$(pid)); }

      allow get: if signedIn() && id.matches('.*_' + request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'tournamentId', 'season', 'playerId', 'alternateId', 'displayName', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.tournamentId + '_' + request.auth.uid
        && request.resource.data.playerId != request.resource.data.alternateId
        && inField(request.resource.data.playerId)
        && inField(request.resource.data.alternateId)
        && request.resource.data.season == oadTournament().season
        && isText(request.resource.data.displayName, 1, 60)
        && request.resource.data.updatedAt == request.time
        && request.time < oadTournament().firstTeeTime;
    }

    // Resultados de «Sin repetir» (los escribe el motor)
    match /oadResults/{id} {
      allow read: if signedIn();
    }

    match /leagues/{lid} {
      function league() { return request.resource.data; }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Al crear la liga se crea a la vez su código de invitación (ver leagueCodes)
      allow create: if signedIn()
        && league().keys().hasOnly(['name', 'code', 'ownerUid', 'memberIds', 'createdAt'])
        && isText(league().name, 3, 40)
        && league().ownerUid == request.auth.uid
        && league().memberIds == [request.auth.uid]
        && league().createdAt == request.time
        && getAfter(/databases/$(database)/documents/leagueCodes/$(league().code)).data.leagueId == lid;

      allow update: if signedIn() && (
        // Unirse: solo te añades a ti mismo (máximo 50 miembros)
        (onlyChanges(['memberIds'])
          && !(request.auth.uid in resource.data.memberIds)
          && league().memberIds == resource.data.memberIds.concat([request.auth.uid])
          && league().memberIds.size() <= 50)
        // Salir: te quitas a ti mismo; el creador no puede salir de su liga
        || (onlyChanges(['memberIds'])
          && request.auth.uid != resource.data.ownerUid
          && request.auth.uid in resource.data.memberIds
          && league().memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet()))
        // Renombrar: solo el creador
        || (onlyChanges(['name'])
          && request.auth.uid == resource.data.ownerUid
          && isText(league().name, 3, 40))
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // Vestuario: mensajes de la liga, solo entre sus miembros
      match /messages/{mid} {
        function isMember() { return request.auth.uid in get(/databases/$(database)/documents/leagues/$(lid)).data.memberIds; }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'color', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && isText(request.resource.data.displayName, 1, 60)
          && isOptionalText(request.resource.data.color, 20)
          && isText(request.resource.data.text, 1, 280)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Código de invitación → liga. Se puede consultar un código concreto, pero no listarlos.
    // Guarda también el nombre de la liga, para que el enlace de invitación muestre a qué liga te unes.
    match /leagueCodes/{code} {
      function leagueAfter() { return getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data; }

      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['leagueId', 'name'])
        && leagueAfter().ownerUid == request.auth.uid
        && leagueAfter().code == code
        && (!('name' in request.resource.data) || request.resource.data.name == leagueAfter().name);
      // Al renombrar la liga se renombra aquí también
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && leagueAfter().ownerUid == request.auth.uid
        && request.resource.data.name == leagueAfter().name;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.ownerUid == request.auth.uid;
    }
  }
}
